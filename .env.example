# ==============================================================================
# CampusSphere Production & Docker Environment Variables
# ==============================================================================

# Database Connection (MongoDB Atlas Cloud Cluster)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@event-management.o8uyxsv.mongodb.net/campussphere?retryWrites=true&w=majority&appName=event-management
MONGODB_DATABASE=campussphere

# Application Ports
SERVER_PORT=8080
CLIENT_PORT=80
CLIENT_SSL_PORT=443

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod

# Venue Conflict Buffer Engine (Minutes)
VENUE_SETUP_BUFFER=30
VENUE_CLEANUP_BUFFER=30

# Razorpay Payment Gateway Credentials (Production / Test)
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourSecretKeyHere

# JWT Authentication
JWT_SECRET=campussphere_production_super_secret_jwt_key_arya_college_2026_xyz987
JWT_EXPIRATION_MS=86400000

# Institution Branding
CAMPUS_NAME="Arya College of Engineering & IT (ACEIT)"
CAMPUS_LOCATION="Jaipur, Rajasthan, India"
